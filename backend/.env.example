# DealPilot Backend Environment Variables Example
PORT=5000
NODE_ENV=development

# DEMO MODE ONLY — authentication bypass enabled for hackathon demo
DEMO_MODE=true

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/dealpilot

# Seeded local/Render company account
COMPANY_NAME=DealPilot Demo Company
COMPANY_EMAIL=company@dealpilot.ai
COMPANY_PASSWORD=Company@2026Secure!
COMPANY_USER_NAME=DealPilot Company User

# Authentication Security (Must be at least 32 characters in production)
JWT_SECRET=your_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

# Admin Account Seed (Created on server startup if provided; idempotent)
ADMIN_EMAIL=admin@dealpilot.ai
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=DealPilot Administrator

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173
# Required for REMOTE AGORA AI: public HTTPS URL that Agora can call.
# Localhost URLs will use the browser/local speech fallback.
BACKEND_PUBLIC_URL=https://your-public-https-url.example.com

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Agora Real-Time Voice Configuration
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret
AGORA_TOKEN_EXPIRY=3600

# Google Calendar OAuth Credentials (Required for Real Google Calendar API)
# Leave blank or unconfigured to operate in Fallback Calendar mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional: Separate Google Auth (Login) credentials from Calendar if desired
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/login

# RAG & Semantic Embedding Configuration
GEMINI_EMBEDDING_MODEL=text-embedding-004
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
